[Unit]
Description=Cytatownik Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/cytatownik
Environment=NODE_ENV=production
# systemd nie ładuje nvm/fnm — użyj login shell, żeby wziąć Node 24 jak w `node -v`
ExecStart=/bin/bash -lc 'cd /opt/cytatownik && exec node ./node_modules/tsx/dist/cli.mjs src/index.ts'
Restart=always
RestartSec=10
KillMode=process

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
