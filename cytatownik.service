[Unit]
Description=Cytatownik Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cytatownik
Group=cytatownik
WorkingDirectory=/opt/cytatownik
Environment=NODE_ENV=production
ExecStart=/opt/cytatownik/node_modules/.bin/tsx src/index.ts
Restart=always
RestartSec=10
KillMode=process

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
